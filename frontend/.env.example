# Backend API Configuration
REACT_APP_API_URL=http://localhost:8081/api

# Public address of the shop website (no trailing slash), e.g.
# https://welcomecraft.com.np. Used for canonical links, social cards and
# robots.txt; falls back to the address the site is opened on.
REACT_APP_SITE_URL=

# WhatsApp number for order and contact messages (country code, digits only)
REACT_APP_WHATSAPP_PHONE=977XXXXXXXXXX

# Shop details shown in the footer, About and Contact pages.
# Leave a value empty to hide it.
REACT_APP_SHOP_PHONE=+977-9714652103
REACT_APP_SHOP_HOURS=Sunday – Friday, 10 AM – 7 PM
REACT_APP_SHOP_EMAIL=
REACT_APP_FACEBOOK_URL=
REACT_APP_INSTAGRAM_URL=
REACT_APP_TIKTOK_URL=


# App Configuration
REACT_APP_NAME=Welcome Craft
REACT_APP_VERSION=1.0.0

# WeChat ID or phone number with country code people search for in WeChat
REACT_APP_WECHAT_ID=+977XXXXXXXXXX
# Optional: WeChat QR code image in public/, e.g. images/wechat-qr.png
REACT_APP_WECHAT_QR=
