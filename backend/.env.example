# Database Configuration
mongo_uri=mongodb+srv://supesh:Supesh123@supesh.qf6hvfg.mongodb.net/Welcome_Craft

# Server Configuration  
PORT=8081
port=8081

# Node Environment
NODE_ENV=development

# JWT Configuration for Admin Authentication
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_secure
JWT_EXPIRES_IN=7d

# Order emails (optional). One checkout sends one email to the shop
# (ADMIN_EMAIL, below) and one to the customer, if they gave an email address.
# Leave SMTP_HOST empty to turn emails off.
#
# Gmail: turn on 2-step verification, create an app password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true for port 465, false for 587 (worked out from the port if left out)
SMTP_SECURE=false
SMTP_USER=sthayush.1985@gmail.com
SMTP_PASS=uzco msnr ppfa misb
# Sender shown to customers (defaults to SMTP_USER)
EMAIL_FROM="Welcome Craft <wcraft@gmail.com>"
# New orders are emailed to ADMIN_EMAIL (in the admin section below)
# The shop's web address, used for links in the emails (optional)
SHOP_URL=https://welcomecraft.com

# Optional: WhatsApp/Telegram configuration for orders
WHATSAPP_PHONE=+977-XXXXXXXXX
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Admin Default Credentials (for initial setup)
# Also where new order emails go; separate several addresses with commas
ADMIN_EMAIL=sthayush.1985@gmail.com
ADMIN_PASSWORD=admin123

# Optional: exchange rates used only if Nepal Rastra Bank and open.er-api.com
# can't be reached and none were saved before. NPR per 1 unit of currency.
# FX_NPR_PER_UNIT=USD:135.2,CNY:18.7

# Optional: Silver Price API Configuration
SILVER_PRICE_API_URL=https://www.sharesansar.com/bullion
GOLD_PRICE_API_URL=https://www.sharesansar.com/bullion

# Public address of the shop website (no trailing slash). Used for the links
# in /sitemap.xml and allowed by CORS, e.g. https://welcomecraft.com.np
SITE_URL=http://localhost:3000

# Other sites allowed to call the API from a browser, comma separated
# (e.g. https://www.welcomecraft.com.np). In development any localhost port
# is allowed. Set NODE_ENV=production in production.
CORS_ORIGINS=
